{
  "name": "marrakech-expedition-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototype statique React « Marrakech Expédition » (données simulées, charte Ecare / CIMAR)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/msal-browser": "5.29.0",
    "@azure/msal-react": "5.8.1",
    "@microsoft/signalr": "11.0.0",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.4.0",
    "react-router-dom": "6.30.6",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react-swc": "3.7.2",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "jsdom": "26.1.0",
    "prettier": "3.3.3",
    "sass": "1.80.6",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "3.2.4"
  }
}
